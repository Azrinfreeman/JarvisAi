# Keep .env private. Self-hosters supply their OWN Discord bot token and matching application ID.
DISCORD_BOT_TOKEN=replace-with-sleep-bot-token
DISCORD_APPLICATION_ID=replace-with-sleep-bot-application-id
DISCORD_GUILD_ID=replace-with-ai-server-id
OWNER_DISCORD_ID=replace-with-owner-id
ACCESS_MODE=server
ALLOWED_CHANNEL_IDS=
ALLOWED_ROLE_IDS=
AI_PROVIDER=chatgpt
# For your own API project, choose openai instead and configure the fields below or use Settings.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_REASONING_EFFORT=
# OPENAI_WEB_SEARCH=false
# Voice listening is separate from ambience and starts only by explicit Discord command/opt-in.
VOICE_SUMMARY_ENABLED=false
# Set to server only when everyone in the configured server has already consented.
VOICE_SUMMARY_CONSENT_MODE=individual
VOICE_SUMMARY_PROVIDER=local
VOICE_SUMMARY_LOCAL_DEVICE=vulkan
# Local audio stays on this device; transcripts go to the selected text/summary provider.
# Run Set up local transcription in Settings once. No speech API key is needed.
# The model and monthly allowance below apply only to VOICE_SUMMARY_PROVIDER=openai.
VOICE_SUMMARY_MODEL=gpt-transcribe
VOICE_SUMMARY_LANGUAGES=ms,en
VOICE_SUMMARY_GLOSSARY=
VOICE_SUMMARY_MINUTES=5
VOICE_SUMMARY_MONTHLY_MINUTES=60
VOICE_SUMMARY_LANGUAGE=Malay
# Required only when voice summaries are enabled with VOICE_SUMMARY_PROVIDER=openai.
# Independent OpenAI speech credential, even when AI_PROVIDER=chatgpt. Prefer protected Settings.
# VOICE_SUMMARY_API_KEY=
# Test explicitly in voice channel text chat: /voice-summary test seconds:30 (cloud may use API credit).
CHATGPT_MODEL=gpt-6-luna
CHATGPT_REASONING_EFFORT=high
# Optional sleep controller roles; owner/Admin/Manage Server already qualify.
CONTROLLER_ROLE_IDS=
RAIN_VOLUME=0.2
RECONNECT_MIN_MS=5000
RECONNECT_MAX_MS=300000
# Defaults: data/ai, data/sleep/sessions.sqlite, and bundled assets/.
# AI_DATA_DIR=
# SLEEP_DATABASE_PATH=
# SLEEP_ASSET_DIR=
