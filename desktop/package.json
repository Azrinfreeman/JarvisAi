{
  "name": "rainbot-desktop",
  "productName": "RainBot",
  "version": "0.3.3",
  "private": true,
  "description": "Personal Discord companion and ambience controls",
  "author": "RainBot contributors",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make --platform=win32 --arch=x64"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3"
  }
}
