{
  "name": "jarvis-sleep-companion",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "desktop:prepare": "node scripts/desktop-build.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:smoke": "npm --prefix desktop start -- --rainbot-smoke",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:make": "npm --prefix desktop run make",
    "dashboard": "node --import tsx src/dashboard/server.ts",
    "start": "node --import tsx src/main.ts",
    "auth": "node --import tsx src/auth-cli.ts",
    "register": "node --import tsx src/register.ts",
    "check": "tsc --noEmit",
    "voice:eval": "node --import tsx scripts/voice-summary-eval.ts",
    "voice:local:setup": "node --import tsx scripts/local-speech-setup.ts",
    "voice:local:smoke": "node --import tsx scripts/local-speech-smoke.ts",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "jose": "6.2.12",
    "sharp": "0.35.5",
    "@discordjs/voice": "0.19.2",
    "opusscript": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
